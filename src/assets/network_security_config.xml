<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">pinum.org.pk</domain>
    <domain includeSubdomains="true">www.pinum.org.pk</domain>
    <trust-anchors>
      <certificates src="@raw/gogetssl_ca" />
      <certificates src="system" />
      <certificates src="user" />
    </trust-anchors>
  </domain-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
      <certificates src="user" />
    </trust-anchors>
  </base-config>
</network-security-config>
