{
  "expo": {
    "name": "pinumapp",
    "slug": "pinumapp",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "scheme": "pinumapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abrar.pinumapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": false
        },
        "NSCameraUsageDescription": "PINUM uses camera to capture test prescription slips for consultation.",
        "NSPhotoLibraryUsageDescription": "PINUM accesses photos to select test prescription slips for consultation."
      }
    },
    "android": {
      "package": "com.abrar.pinumapp",
      "versionCode": 2,
      "usesCleartextTraffic": false,
      "allowBackup": false,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#111217"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/pinum_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-font",
        {
          "fonts": ["./src/assets/fonts/JameelNooriNastaleeq.ttf"]
        }
      ],
      "./plugins/withAndroidCertificates"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    }
  }
}
